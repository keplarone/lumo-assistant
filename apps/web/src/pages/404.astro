---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title="Page not found" description="The page you were looking for does not exist." noindex>
  <section class="container notfound" aria-labelledby="nf-title">
    <p class="eyebrow">404</p>
    <h1 class="display page-title" id="nf-title">Lumo looked everywhere.</h1>
    <p class="lede">This page does not exist. Everything on this site now lives on the download page.</p>
    <div class="cta-row">
      <a class="lu-button" data-variant="primary" data-size="lg" href="/">Download Lumo</a>
      <a class="lu-button" data-variant="secondary" data-size="lg" href={SITE.issues}>Report an issue</a>
    </div>
  </section>
</Base>
