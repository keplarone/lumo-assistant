---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for does not exist." noindex>
  <section class="container notfound" aria-labelledby="nf-title">
    <p class="eyebrow">404</p>
    <h1 class="display page-title" id="nf-title">Lumo looked everywhere.</h1>
    <p class="lede">This page does not exist, or it moved. Try one of these instead.</p>
    <div class="cta-row">
      <a class="lu-button" data-variant="primary" data-size="lg" href="/">Home</a>
      <a class="lu-button" data-variant="secondary" data-size="lg" href="/docs/">Getting started</a>
      <a class="lu-button" data-variant="ghost" data-size="lg" href="/support/">Support</a>
    </div>
  </section>
</Base>
