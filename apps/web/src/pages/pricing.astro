---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PlanCards from '../components/PlanCards.astro';
import { BILLING_PERIOD, CURRENCY } from '../data/plans';
---

<Base title="Pricing" description="Lumo will launch with three plans: Free, Lumo Lite and Lumo Pro. Lumo is in pre-release, so plans cannot be bought yet.">
  <PageHead
    eyebrow="Pricing"
    title="Three plans, at launch."
    lede="Start free, and move up when you want more tasks, automations and building tools. Lumo is in pre-release: these are the plans it will launch with, and nothing can be bought yet."
  />
  <div class="container">
    <PlanCards level={2} />
    <p class="dl-note">
      Prices in {CURRENCY}, {BILLING_PERIOD.label}. Monthly limits for each plan will be published before launch. Badges show a feature’s current
      development status; see <a href="/features/">Features</a>.
    </p>
    <div class="cta-row plans-cta">
      <a class="lu-button" data-variant="primary" data-size="lg" href="/download/">Download</a>
    </div>

    <section class="section" aria-labelledby="faq-title">
      <div class="section-head">
        <h2 class="h-display" id="faq-title">Questions</h2>
      </div>
      <div class="prose faq">
        <h3>Can I buy a plan now?</h3>
        <p>Not yet. Lumo is in pre-release; plans open at launch.</p>
        <h3>What if a feature in my plan is still in development?</h3>
        <p>Each plan lists the features it is designed to include. Where a feature is not finished yet, its badge says so.</p>
        <h3>Do purchases made through Lumo cost extra?</h3>
        <p>
          No. When Lumo helps you order food or shop, it hands you off to the provider or merchant, and you pay them at their normal prices. Lumo
          takes no fee and does not handle payment.
        </p>
      </div>
    </section>
  </div>
</Base>
