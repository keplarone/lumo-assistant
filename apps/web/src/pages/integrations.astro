---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { capability, type CapabilityId } from '../data/capabilities';

const groups: { title: string; intro: string; items: { id: CapabilityId; how: string }[] }[] = [
  {
    title: 'Model provider',
    intro: 'The model that does the understanding, planning and writing.',
    items: [{ id: 'conversations', how: 'Claude models from Anthropic. Higher plans use the most capable model.' }],
  },
  {
    title: 'On your computer',
    intro: 'Built in. Each needs a grant from you before it can be used.',
    items: [
      { id: 'files', how: 'Folders you pick in a system file dialog. Nothing outside them is visible to Lumo.' },
      { id: 'web-research', how: 'Search and page reading. Page content is treated as untrusted data.' },
      { id: 'project-workspace', how: 'A workspace folder you choose. Each project is a git repository with a local preview server.' },
      { id: 'computer-use', how: 'Separate screen and input-control permissions, a visible indicator and a global stop shortcut.' },
      { id: 'voice', how: 'Microphone permission, with the live indicator shown whenever it is listening.' },
    ],
  },
  {
    title: 'Ordering and shopping',
    intro: 'Lumo researches and hands off. The provider or merchant completes checkout.',
    items: [
      { id: 'restaurant-finder', how: 'Place search with your saved location, then a link out to DoorDash, Uber Eats or the restaurant’s own website.' },
      { id: 'shopping-research', how: 'Comparison from public product pages, then a link out to the merchant’s page.' },
      { id: 'direct-food-ordering', how: 'Only through a provider’s official program, once approved: DoorDash dd-cli beta and Uber Consumer Delivery early access.' },
    ],
  },
  {
    title: 'Accounts',
    intro: 'Connected with the provider’s own sign-in. Disconnect at any time in Settings.',
    items: [
      { id: 'google', how: 'Google sign-in for Calendar, Gmail and Drive. Sending email always needs your confirmation.' },
      { id: 'github', how: 'GitHub sign-in to push projects and read issues.' },
      { id: 'netlify', how: 'Netlify sign-in. Every deploy needs your confirmation.' },
    ],
  },
];
---

<Base title="Integrations" description="The services and system capabilities Lumo connects to, how each connection works, and the real status of each one.">
  <PageHead
    eyebrow="Integrations"
    title="Connected to your tools, on your terms."
    lede="Every integration is off until you turn it on, and each one shows its real status. Product names belong to their owners; Lumo is not affiliated with or endorsed by them."
  />
  <div class="container">
    {
      groups.map((g, i) => (
        <section aria-labelledby={`int-${i}`} class="int-group">
          <h2 class="h-display group-title" id={`int-${i}`}>
            {g.title}
          </h2>
          <p class="muted group-intro">{g.intro}</p>
          <ul class="cap-list">
            {g.items.map(({ id, how }) => {
              const c = capability(id);
              return (
                <li class="cap-row">
                  <div>
                    <h3 class="h3">{c.name}</h3>
                    <p>{how}</p>
                    {c.note && <p class="note">{c.note}</p>}
                  </div>
                  <StatusBadge status={c.status} />
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
