---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import DownloadGrid from '../components/DownloadGrid.astro';
import { release, RELEASES_URL } from '../data/downloads';
import { softwareApplication } from '../data/schema';
---

<Base
  title="Download"
  description="Download Lumo for Windows, macOS and Linux. Lumo is pre-release: builds will be published on GitHub Releases."
  jsonLd={[softwareApplication(Astro.site)]}
>
  <PageHead
    eyebrow="Download"
    title="Get Lumo for your desktop."
    lede={release.released
      ? `Version ${release.version}. Free for Windows, macOS and Linux.`
      : 'Lumo has not had its first release yet. When it does, signed builds for every platform will appear on GitHub Releases. The links below go there.'}
  />
  <div class="container">
    <DownloadGrid level={2} />
    <p class="dl-note">{release.requirementsNote}</p>

    <section class="section" aria-labelledby="after-title">
      <div class="section-head">
        <h2 class="h-display" id="after-title">After you install</h2>
      </div>
      <ol class="steps-list">
        <li>
          <div>
            <h3 class="h3">Add your Anthropic API key</h3>
            <p>Lumo stores it in your operating system’s keychain. You pay Anthropic directly for what you use.</p>
          </div>
        </li>
        <li>
          <div>
            <h3 class="h3">Grant a folder, if you want file help</h3>
            <p>Lumo only sees folders you pick. You can revoke access at any time.</p>
          </div>
        </li>
        <li>
          <div>
            <h3 class="h3">Ask for something</h3>
            <p>Start small: a question, a summary of a document, a tidy-up plan for a folder.</p>
          </div>
        </li>
      </ol>
      <p class="helps-more"><a href="/docs/">Read the getting-started guide</a></p>
    </section>

    <section aria-labelledby="verify-title">
      <div class="section-head">
        <h2 class="h-display" id="verify-title">Updates and verification</h2>
      </div>
      <div class="prose">
        <p>
          Lumo will update itself through the built-in updater, which checks a signature on every update before installing it. Each release on
          <a href={RELEASES_URL}>GitHub Releases</a> will list the files with their checksums.
        </p>
      </div>
    </section>
  </div>
</Base>
