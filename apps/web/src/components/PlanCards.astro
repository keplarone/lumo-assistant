---
/** Plan cards, read from src/data/plans.ts. `compact` is the homepage teaser (no feature lists). */
import StatusBadge from './StatusBadge.astro';
import { BILLING_PERIOD, PLANS, PLAN_AVAILABILITY, formatPrice } from '../data/plans';
import { capability } from '../data/capabilities';

interface Props {
  compact?: boolean;
  /** Heading level for plan names, so the outline stays in order on each page. */
  level?: 2 | 3;
}
const { compact = false, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<ul class:list={['plans plain-list', { compact }]} role="list">
  {
    PLANS.map((p) => (
      <li class="plan panel" data-plan={p.id} data-highlighted={p.highlighted ? '' : undefined}>
        <div class="plan-top">
          <H class="h3 plan-name" id={`plan-${p.id}`}>
            {p.name}
          </H>
          <span class="lu-badge" data-tone="warning">
            {PLAN_AVAILABILITY}
          </span>
        </div>
        <p class="plan-price">
          <span class="plan-amount">{formatPrice(p)}</span>
          <span class="plan-period">{BILLING_PERIOD.suffix}</span>
        </p>
        <p class="plan-tagline">{p.tagline}</p>
        {!compact && (
          <>
            {p.includes && <p class="plan-includes">{p.includes}</p>}
            <ul class="plan-features plain-list" aria-labelledby={`plan-${p.id}`}>
              {p.features.map((f) => {
                const status = f.capability ? capability(f.capability).status : undefined;
                return (
                  <li>
                    <span>{f.text}</span>
                    {status && status !== 'available' && <StatusBadge status={status} />}
                  </li>
                );
              })}
            </ul>
          </>
        )}
      </li>
    ))
  }
</ul>
