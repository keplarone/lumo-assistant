---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="container">
  <div class="page-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display page-title">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>
