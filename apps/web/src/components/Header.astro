---
import Logo from './Logo.astro';
import { PRIMARY_NAV } from '../data/site';

interface Props {
  current: string;
}
const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = norm(Astro.props.current);
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Lumo home">
      <Logo />
      <span class="brand-name">Lumo</span>
    </a>
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="lu-button header-cta" data-variant="primary" data-size="md" href="/download/">Get Lumo</a>
      <details class="nav-mobile">
        <summary aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          <span>Menu</span>
        </summary>
        <nav aria-label="Mobile">
          <ul>
            {
              PRIMARY_NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/download/">Download</a></li>
            <li><a href="/support/">Support</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
