---
import { AppWindow, Laptop, SquareTerminal } from 'lucide-react';
import { PLATFORMS, RELEASES_URL, buildHref, release } from '../data/downloads';

interface Props {
  /** Homepage variant: one link per platform. */
  compact?: boolean;
  /** Heading level for platform names, so the outline stays in order on each page. */
  level?: 2 | 3;
}
const { compact = false, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
// Generic device icons only: no operating-system logos.
const icons = { windows: AppWindow, macos: Laptop, linux: SquareTerminal };
---

<div class:list={['dl-grid', { compact }]}>
  {
    PLATFORMS.map((p) => {
      const Icon = icons[p.id];
      return (
      <section class="dl-card panel" aria-labelledby={`dl-${p.id}`}>
        <div class="dl-head">
          <span class="icon-tile"><Icon aria-hidden="true" /></span>
          <H class="h3" id={`dl-${p.id}`}>
            {p.name}
          </H>
          {!release.released && <span class="lu-badge" data-tone="warning">{release.statusLabel}</span>}
        </div>
        <ul class="dl-builds" role="list">
          {p.builds.map((b) => (
            <li>
              <a class="dl-build" href={buildHref(b)}>
                <span class="dl-build-label">
                  {b.label} <span class="mono dl-format">{b.format}</span>
                </span>
                {!compact && <span class="dl-build-detail">{b.detail}</span>}
              </a>
            </li>
          ))}
        </ul>
        {!compact && <p class="note">{p.requirements}</p>}
      </section>
      );
    })
  }
</div>
{
  !release.released && (
    <p class="dl-note">
      No builds are published yet. Links go to <a href={RELEASES_URL}>GitHub Releases</a>, where signed builds will appear with the first release.
    </p>
  )
}
