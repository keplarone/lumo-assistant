---
/**
 * "Build me a website": plan → create → test → deliver.
 *
 * A layered visual (HTML panels in CSS 3D perspective) sits beside four steps. As each step crosses
 * the middle of the viewport (IntersectionObserver on native scroll; nothing intercepts the wheel),
 * its panel comes forward. The steps and panels are plain HTML, so the sequence reads in full without
 * JavaScript. With reduced motion (or without JavaScript) the panels stay in a static composition.
 */
import StatusBadge from './StatusBadge.astro';
import { capability } from '../data/capabilities';

const project = capability('project-workspace');
const steps = [
  {
    id: 'plan',
    title: 'Plan',
    text: 'Lumo turns your request into a short plan you can read and change before anything is made: pages, style, content, checks.',
  },
  {
    id: 'create',
    title: 'Create',
    text: 'It writes the files into a project in a folder you granted. Each change is saved to version history, so any step can be rolled back.',
  },
  {
    id: 'test',
    title: 'Test',
    text: 'It checks its own work before telling you it is done: broken links, contrast, the layout at phone width, build errors.',
  },
  {
    id: 'deliver',
    title: 'Deliver',
    text: 'You get a live preview and a plain summary of what was made and what was checked. Publishing to a host is a separate step you confirm.',
  },
];
---

<div class="build" data-build>
  <div class="build-visual" aria-hidden="true">
    <div class="build-scene">
      <svg class="build-links" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M 27 22 L 73 30 L 27 70 L 73 76"></path>
      </svg>
      <div class="build-layer" data-layer="plan">
        <div class="bl-head"><span>Plan</span><span class="bl-chip">4 steps</span></div>
        <ul class="bl-list">
          <li data-done>Pages: Home, Menu, Visit us</li>
          <li data-done>Warm type pairing, cream and cocoa palette</li>
          <li>Write copy from your notes</li>
          <li>Check links, contrast, phone layout</li>
        </ul>
      </div>
      <div class="build-layer" data-layer="create">
        <div class="bl-head"><span>bakery-site</span><span class="bl-chip">3 files written</span></div>
        <ul class="bl-tree">
          <li><span class="bl-file">index.html</span><span class="bl-add">+84</span></li>
          <li><span class="bl-file">menu.html</span><span class="bl-add">+61</span></li>
          <li><span class="bl-file">styles.css</span><span class="bl-add">+132</span></li>
          <li class="bl-commit">Saved to history: “First version of the site”</li>
        </ul>
      </div>
      <div class="build-layer" data-layer="test">
        <div class="bl-head"><span>Checks</span><span class="bl-chip bl-ok">All passed</span></div>
        <ul class="bl-checks">
          <li><span>Internal links</span><span class="bl-ok">ok</span></li>
          <li><span>Text contrast (WCAG AA)</span><span class="bl-ok">ok</span></li>
          <li><span>Layout at 360px</span><span class="bl-ok">ok</span></li>
          <li><span>Build</span><span class="bl-ok">ok</span></li>
        </ul>
      </div>
      <div class="build-layer" data-layer="deliver">
        <div class="bl-browser">
          <span class="bl-dot"></span><span class="bl-dot"></span><span class="bl-dot"></span>
          <span class="bl-url">localhost preview</span>
        </div>
        <div class="bl-site">
          <span class="bl-site-name">Rise &amp; Crumb</span>
          <span class="bl-site-line"></span>
          <span class="bl-site-line short"></span>
          <span class="bl-site-grid"><i></i><i></i><i></i></span>
        </div>
      </div>
    </div>
    <p class="build-caption">Illustration of a sample project</p>
  </div>

  <div class="build-steps">
    <p class="build-request"><span class="eyebrow">You ask</span> “Build me a website for my bakery.”</p>
    <p class="build-status"><StatusBadge status={project.status} /> <span>Project workspace</span></p>
    <ol>
      {
        steps.map((s, i) => (
          <li class="build-step" data-step={s.id}>
            <span class="build-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<script>
  // Enhancement only: mark the step nearest the middle of the viewport as active.
  const root = document.querySelector<HTMLElement>('[data-build]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (root && 'IntersectionObserver' in window && !reduce.matches) {
    root.dataset.enhanced = '';
    root.dataset.active = 'plan';
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) root.dataset.active = (e.target as HTMLElement).dataset.step ?? 'plan';
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>
