    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
