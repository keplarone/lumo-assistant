{
  "name": "lumo-assistant",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lumo/desktop dev",
    "build": "pnpm -r build",
